{
  "name": "Canary",
  "tagline": "Browser-driven QA workflows in Claude",
  "description": "Author, run, and triage Canary browser-testing workflows directly from Claude. Surfaces workflows, test suites, runs, issues, and credentials for your organisation.",
  "homepage": "https://trycanary.ai",
  "documentation": "https://docs.trycanary.ai/integrations/claude",
  "support_email": "support@trycanary.ai",
  "privacy_policy": "https://trycanary.ai/legal/privacy",
  "terms_of_service": "https://trycanary.ai/legal/terms",
  "logo": {
    "png_512": "https://mcp.trycanary.ai/icon.png"
  },
  "mcp": {
    "server_url": "https://mcp.trycanary.ai/mcp",
    "transport": "streamable-http",
    "discovery": {
      "oauth_authorization_server": "https://mcp.trycanary.ai/.well-known/oauth-authorization-server",
      "oauth_protected_resource": "https://mcp.trycanary.ai/.well-known/oauth-protected-resource"
    }
  },
  "oauth": {
    "issuer": "https://mcp.trycanary.ai",
    "authorization_endpoint": "https://mcp.trycanary.ai/oauth/authorize",
    "token_endpoint": "https://mcp.trycanary.ai/oauth/token",
    "registration_endpoint": "https://mcp.trycanary.ai/oauth/register",
    "revocation_endpoint": "https://mcp.trycanary.ai/oauth/revoke",
    "supports_dynamic_client_registration": true,
    "pkce": "S256-required",
    "scopes": [
      {
        "name": "org:full",
        "description": "Read and write access to the selected Canary organisation's workflows, test suites, runs, issues, and credentials."
      }
    ]
  },
  "tool_groups": [
    "workflows",
    "workflow-proposals",
    "workflow-runs",
    "test-suites",
    "credentials",
    "issues"
  ]
}
